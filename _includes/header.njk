<script>
  /* Self-evict any old service worker registered against this origin in earlier
     dev sessions. Without this, returning visitors can get stale HTML served
     from SW cache (the bug that surfaced raw {% raw %}{% include "header.njk" %}{% endraw %}
     placeholders before the Eleventy migration). One-shot, no-op once removed. */
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then(function (regs) {
      regs.forEach(function (r) { r.unregister(); });
    }).catch(function () { /* fail silent — defensive only */ });
  }
</script>
<!-- Critical inline: ensures black page bg before external CSS arrives -->
